<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings: resolves all dependencies and plugins from
  Maven Central instead of the corporate mirror configured in ~/.m2/settings.xml.
  Picked up automatically via .mvn/maven.config when running ./mvnw.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- Separate local repo so corporate-cached artifacts don't mix with Central ones -->
  <localRepository>${user.home}/.m2/repository-central</localRepository>

  <mirrors>
    <mirror>
      <id>central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

</settings>
